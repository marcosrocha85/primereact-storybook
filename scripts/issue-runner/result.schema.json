{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "pr_title", "pr_body", "changed_files", "validations", "api_review_complete", "blockers", "blocker_kind", "recovery_notes"],
  "properties": {
    "blocker_kind": { "type": "string", "enum": ["none", "technical", "external", "permission", "scope"] },
    "recovery_notes": { "type": "string" },
    "status": { "type": "string", "enum": ["ready", "blocked"] },
    "pr_title": {
      "type": "string",
      "pattern": "^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\\([a-z0-9][a-z0-9._/-]*\\))?!?: \\S(?:.*\\S)?$"
    },
    "pr_body": { "type": "string" },
    "changed_files": { "type": "array", "items": { "type": "string" } },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status"],
        "properties": {
          "command": { "type": "string" },
          "status": { "type": "string", "enum": ["passed", "failed", "blocked"] }
        }
      }
    },
    "api_review_complete": { "type": "boolean" },
    "blockers": { "type": "array", "items": { "type": "string" } }
  }
}
